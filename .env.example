# ─── PostHog Analytics ─────────────────────────────────────────────────────────
# Get these from your PostHog project: Settings → Project → Project API Key.
# Copy this file to `.env.local` for local dev, and add the same vars in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.
# If VITE_POSTHOG_KEY is left empty, analytics are disabled and the app still runs.

VITE_POSTHOG_KEY=
# US cloud:  https://us.i.posthog.com   (default)
# EU cloud:  https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
